# =============================================================================
# Album Backend 环境变量配置文件示例
# =============================================================================
# 使用方法：
# 1. 复制此文件为 .env: cp .env.example .env
# 2. 根据实际需求修改配置值
# 3. docker-compose 会自动读取 .env 文件中的变量
# =============================================================================

# -----------------------------------------------------------------------------
# 架构配置
# -----------------------------------------------------------------------------
# 系统架构（amd64 或 arm64），通常会自动检测，无需手动设置
ALBUM_ARCH=amd64

# -----------------------------------------------------------------------------
# PostgreSQL 数据库配置
# -----------------------------------------------------------------------------
# 数据库用户名
ALBUM_POSTGRES_USER=album
# 数据库密码（生产环境请务必修改）
ALBUM_POSTGRES_PASSWORD=album
# 数据库名称
ALBUM_POSTGRES_DB=album

# -----------------------------------------------------------------------------
# 初始化配置（首次部署时需要）
# -----------------------------------------------------------------------------
# 管理员邮箱（首次部署必须设置）
ALBUM_INIT_ADMIN_EMAIL=admin@example.com
# 管理员密码（首次部署必须设置）
ALBUM_INIT_ADMIN_PASSWORD=12345678
# 管理员用户名
ALBUM_INIT_ADMIN_USERNAME=admin
# 存储池最大大小
ALBUM_INIT_STORAGE_MAX_SIZE=1TB
# 是否强制初始化
ALBUM_INIT_FORCE=true

# -----------------------------------------------------------------------------
# 服务器配置
# -----------------------------------------------------------------------------
# 公共访问地址（生产环境请修改为实际域名）
ALBUM_SERVER_PUBLIC_BASE_URL=http://localhost

# -----------------------------------------------------------------------------
# 认证配置（生产环境请务必修改）
# -----------------------------------------------------------------------------
# JWT 密钥（生产环境请使用强随机字符串）
ALBUM_AUTH_JWT_SECRET=album-dev-jwt-secret-key-change-in-production
# URL 签名密钥（生产环境请使用强随机字符串）
ALBUM_AUTH_URL_SIGNER_SECRET=album-dev-signer-secret-change-in-production
# Access Token 过期时间
ALBUM_AUTH_ACCESS_TOKEN_EXPIRES_IN=30m
# Refresh Token 过期时间
ALBUM_AUTH_REFRESH_TOKEN_EXPIRES_IN=720h

# -----------------------------------------------------------------------------
# 存储配置（仅影响临时/缓存目录；媒体文件路径由存储池 location URI 决定）
# -----------------------------------------------------------------------------
# 工作根目录（temp/staging/cache 默认在其下）
ALBUM_STORAGE_PRIMARY_LOCAL_DATA_DIR=./
# 临时文件目录（可选，空时使用 data_dir/temp）
# ALBUM_STORAGE_PRIMARY_LOCAL_TEMP_BASE_PATH=./data/temp
# 磁盘缓存目录（可选，空时使用 data_dir/cache）
# ALBUM_STORAGE_PRIMARY_LOCAL_PERFORMANCE_CACHE_PATH=./data/cache

# -----------------------------------------------------------------------------
# 媒体处理配置
# -----------------------------------------------------------------------------
# 最大文件大小
ALBUM_MEDIA_MAX_FILE_SIZE=2GB
# 媒体处理并发数
ALBUM_MEDIA_PROCESSOR_CONCURRENCY=4
# ImageMagick 池大小
ALBUM_MEDIA_PROCESSOR_IMAGICK_POOL_SIZE=10
# ImageMagick 内存限制
ALBUM_MEDIA_PROCESSOR_IMAGICK_MEMORY_LIMIT=2GB
# FFmpeg 二进制路径
ALBUM_MEDIA_PROCESSOR_FFMPEG_BINARY_PATH=/usr/bin/ffmpeg
# FFprobe 二进制路径
ALBUM_MEDIA_PROCESSOR_FFMPEG_PROBE_PATH=/usr/bin/ffprobe

# -----------------------------------------------------------------------------
# 日志配置
# -----------------------------------------------------------------------------
# 日志级别（debug, info, warn, error）
ALBUM_LOGGER_LEVEL=info
# 日志格式（json, console）
ALBUM_LOGGER_FORMAT=json

# -----------------------------------------------------------------------------
# 变更日志配置
# -----------------------------------------------------------------------------
# 是否启用变更日志
ALBUM_CHANGELOG_ENABLED=true

# -----------------------------------------------------------------------------
# CORS 配置
# -----------------------------------------------------------------------------
# 是否启用应用层 CORS（默认由 nginx 处理，通常设为 false）
ALBUM_ENABLE_APP_CORS=false

# -----------------------------------------------------------------------------
# Nginx 配置
# -----------------------------------------------------------------------------
# HTTP 端口
ALBUM_HTTP_PORT=80
# HTTPS 端口
ALBUM_HTTPS_PORT=443
# 是否启用 HTTPS
ALBUM_ENABLE_HTTPS=false
# SSL 证书路径（启用 HTTPS 时需要）
ALBUM_SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
# SSL 私钥路径（启用 HTTPS 时需要）
ALBUM_SSL_KEY_PATH=/etc/nginx/ssl/key.pem
# 最大上传文件大小（Nginx 层）
ALBUM_NGINX_CLIENT_MAX_BODY_SIZE=2G
# 访问日志级别
ALBUM_NGINX_ACCESS_LOG_LEVEL=combined
# 错误日志级别（debug, info, warn, error）
ALBUM_NGINX_ERROR_LOG_LEVEL=warn

# -----------------------------------------------------------------------------
# 构建配置（通常由 Makefile 自动设置，无需手动配置）
# -----------------------------------------------------------------------------
# 版本号（通常从 git tag 获取）
# ALBUM_VERSION=dev
# 构建时间（自动生成）
# ALBUM_BUILD_TIME=
# Git 提交哈希（自动获取）
# ALBUM_GIT_COMMIT=
# Git 分支（自动获取）
# ALBUM_GIT_BRANCH=
