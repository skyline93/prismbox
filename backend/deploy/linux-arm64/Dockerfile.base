FROM debian:bookworm

ARG GOLANG_VERSION=1.23.6
ARG IMAGEMAGICK_VERSION=7.1.1-34

# 配置阿里云镜像源 + darktable 官方源 (ARM64 也支持)
RUN sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources \
    && sed -i 's|security.debian.org|mirrors.aliyun.com/debian-security|g' /etc/apt/sources.list.d/debian.sources \
    # 添加 darktable 官方源 (ARM64 支持)
    && apt-get update -y \
    && apt-get install -y curl gnupg \
    && echo 'deb [arch=arm64] http://download.opensuse.org/repositories/graphics:/darktable/Debian_12/ /' > /etc/apt/sources.list.d/graphics-darktable.list \
    && curl -fsSL https://download.opensuse.org/repositories/graphics:darktable/Debian_12/Release.key | gpg --dearmor > /etc/apt/trusted.gpg.d/graphics_darktable.gpg \
    && apt-get update -y \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# 安装系统依赖 (ARM64优化版本)
RUN apt-get update -y \
    && apt-get install -y \
      vim make wget curl lsof telnet git zip unzip sqlite3 rsync net-tools \
      gcc-aarch64-linux-gnu g++ libvips libvips-dev tmux sudo zsh graphviz \
      xdg-utils dbus-x11 \
      libgl1-mesa-glx libglib2.0-0 \
      libx11-6 libxext6 libxrender1 \
      libsm6 libice6 libxi6 libxtst6 libxt6 libxmu6 libxpm4 libxft2 \
      libxinerama1 libxxf86vm1 libxrandr2 \
      exiftool \
      darktable \
      # RAW处理工具
      dcraw \
      rawtherapee \
      # ImageMagick 7 依赖
      build-essential pkg-config libpng-dev libjpeg-dev libtiff-dev \
      libwebp-dev libfftw3-dev libfreetype6-dev liblcms2-dev libopenexr-dev \
      libheif-dev libraw-dev libxml2-dev \
      # FFmpeg for video processing
      ffmpeg \
      # Additional ARM64 optimized tools
      htop \
      procps \
      --no-install-recommends \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# 安装 ImageMagick 7 (与AMD64版本完全一致)
RUN cd /tmp \
    && curl -LO https://github.com/ImageMagick/ImageMagick/archive/refs/tags/${IMAGEMAGICK_VERSION}.tar.gz \
    && tar xf ${IMAGEMAGICK_VERSION}.tar.gz \
    && cd ImageMagick-${IMAGEMAGICK_VERSION} \
    && ./configure --with-modules --with-fftw --with-heic --with-raw \
                   --prefix=/usr/local --enable-shared --enable-static \
                   --with-quantum-depth=16 --with-hdri=yes --disable-openmp \
    && make -j$(nproc) \
    && make install \
    && ldconfig \
    # 创建符号链接确保头文件可以被找到
    && ln -sf /usr/local/include/ImageMagick-7 /usr/local/include/ImageMagick \
    && ln -sf /usr/local/include/ImageMagick-7/MagickWand /usr/local/include/MagickWand \
    && ln -sf /usr/local/include/ImageMagick-7/MagickCore /usr/local/include/MagickCore \
    # 更新 pkg-config 路径
    && echo '/usr/local/lib/pkgconfig' > /etc/ld.so.conf.d/imagemagick.conf \
    && ldconfig \
    && cd /tmp \
    && rm -rf ImageMagick-${IMAGEMAGICK_VERSION} ${IMAGEMAGICK_VERSION}.tar.gz \
    && magick -version

# 安装 Go for ARM64
RUN curl -O https://mirrors.aliyun.com/golang/go${GOLANG_VERSION}.linux-arm64.tar.gz \
    && rm -rf /usr/local/go && tar -C /usr/local -xzf go${GOLANG_VERSION}.linux-arm64.tar.gz \
    && rm -f go${GOLANG_VERSION}.linux-arm64.tar.gz

ARG USER_ID=1000
ARG GROUP_ID=1000
ARG USER_NAME=app
ARG GROUP_NAME=app

RUN if ! getent group $GROUP_ID; then \
        groupadd -g $GROUP_ID ${GROUP_NAME}; \
    fi && \
    useradd -m -u $USER_ID -g $GROUP_ID ${USER_NAME} && \
    echo "${USER_NAME} ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

USER ${USER_NAME}
WORKDIR /home/${USER_NAME}

# 安装 Oh My Zsh (可选，开发环境使用)
RUN git clone https://gitee.com/mirrors/oh-my-zsh.git ohmyzsh \
    && cd ohmyzsh/tools \
    && REMOTE=https://gitee.com/mirrors/oh-my-zsh.git sh install.sh || true

ARG USER_NAME=app

# Go 环境变量配置
ENV GOROOT=/usr/local/go
ENV GOPATH=/home/${USER_NAME}/go
ENV PATH=$PATH:$GOROOT/bin:$GOPATH/bin
ENV GOPROXY=https://goproxy.cn,direct
ENV GO111MODULE=on
ENV CGO_ENABLED=1
ENV GOMODCACHE=/home/${USER_NAME}/go/pkg/mod

# ImageMagick 环境变量，确保 CGO 能找到头文件和库 (ARM64优化)
ENV PKG_CONFIG_PATH=/usr/local/lib/pkgconfig:/usr/lib/pkgconfig
ENV LD_LIBRARY_PATH=/usr/local/lib:$LD_LIBRARY_PATH
ENV CGO_CFLAGS="-I/usr/local/include/ImageMagick-7"
ENV CGO_LDFLAGS="-L/usr/local/lib -lMagickWand-7.Q16HDRI -lMagickCore-7.Q16HDRI"

# ARM64 架构特定的环境变量
ENV GOARCH=arm64
ENV GOOS=linux

# 安装 Go 开发工具
RUN go install github.com/go-delve/delve/cmd/dlv@latest

CMD ["tail", "-f", "/dev/null"]
