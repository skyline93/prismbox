					"name": "Create Share",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.data) {",
									"        // Extract the token from the URL string",
									"        var url = new URL(jsonData.data);",
									"        var pathSegments = url.pathname.split('/');",
									"        var token = pathSegments[pathSegments.length - 1];",
									"        pm.collectionVariables.set(\"shareToken\", token);",
									"        console.log(\"shareToken has been set to: \" + token);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
